# Copie para .env e preencha depois de criar os recursos na AWS.
# No Dia 1 (containers locais) você pode deixar AWS_* em branco:
# evaluation-service funciona sem SQS (só loga localmente) e
# analytics-service usa o DynamoDB Local do próprio compose.
# analytics-service SEMPRE precisa de uma fila SQS real (ele cai se não tiver).

# Preenchido depois do passo "crie uma chave de API" do auth-service (README dele)
EVALUATION_SERVICE_API_KEY=

# Credenciais da sua conta pessoal AWS (us-east-1 sugerido)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL da fila SQS real que você vai criar na AWS (etapa 2 do roteiro,
# mas pode ser feita adiantada hoje mesmo, é grátis e leva 2 minutos)
AWS_SQS_URL=
